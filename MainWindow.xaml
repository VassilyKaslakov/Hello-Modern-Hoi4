<Window x:Class="Hoi4Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Hoi4Launcher.Models"
        Title="Hello Modern Hoi4"
        Icon="/Assets/hmhoi4.ico"
        Width="1220" Height="800" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ModCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,6,10" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.05" Color="#6B7A90" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="#E7C6A5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="#FDF7F1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 背景图蒙层 -->
        <Rectangle x:Name="BackdropWash" Grid.RowSpan="3" Fill="#E2FFFFFF" Visibility="Collapsed" />

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid Height="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="40" Height="40" RadiusX="11" RadiusY="11">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="/Assets/hmhoi4.png" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Hello Modern Hoi4" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{DynamicResource L.app.subtitle}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource L.btn.workshop}" Click="OpenWorkshop_Click" Margin="0,0,8,0"
                            ToolTip="{DynamicResource L.tip.workshop}" />
                    <Button Content="{DynamicResource L.btn.rescan}" Click="Rescan_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边导航 -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <RadioButton x:Name="NavLaunch" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Tag="launch" IsChecked="True" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.launch}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSaves" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Tag="saves" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.saves}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Tag="settings" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.settings}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavPersonalize" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Tag="personalize" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource L.nav.personalize}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="4,0,4,12" />
                        <TextBlock Text="{DynamicResource L.sidebar.info}" Style="{StaticResource SectionLabel}"
                                   Margin="4,0,0,6" />
                        <TextBlock Text="{Binding GameVersionShort}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="4,0,0,0" />
                        <TextBlock Text="{Binding ModCountText}" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="4,3,0,0" />
                        <TextBlock Text="{Binding GameDirShort}" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 页面 ================= -->
            <Grid Grid.Column="2">

                <!-- 启动页 -->
                <Grid x:Name="PageLaunch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- MOD 列表 -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource L.mods.title}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            <Border Background="#EAF0F7" CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ModCountText}" FontSize="11"
                                           Foreground="{StaticResource NeutralFgBrush}" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="260" HorizontalAlignment="Left">
                                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="32,8,10,8" />
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           Margin="12,0,0,0" IsHitTestVisible="False" />
                                <TextBlock x:Name="SearchHint" Text="{DynamicResource L.search.placeholder}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                           Margin="33,0,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{DynamicResource L.btn.selectall}" Click="SelectAll_Click" />
                                <Button Content="{DynamicResource L.btn.selectnone}" Click="SelectNone_Click" Margin="6,0,0,0" />
                                <Button Content="{DynamicResource L.btn.invert}" Click="Invert_Click" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="2" x:Name="ModList" ItemsSource="{Binding Mods}"
                                 SelectionChanged="ModList_SelectionChanged"
                                 MouseDoubleClick="ModList_MouseDoubleClick"
                                 Padding="0,0,6,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ModEntry}">
                                    <Border Style="{StaticResource ModCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="50" Height="50" VerticalAlignment="Center">
                                                <Border CornerRadius="9" Background="#EEF2F7"
                                                        BorderBrush="#E3E9F1" BorderThickness="1" />
                                                <TextBlock Text="MOD" FontSize="10" Foreground="#A9B4C2"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Rectangle RadiusX="9" RadiusY="9">
                                                    <Rectangle.Fill>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SubLine}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource CompatBadgeBorder}" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource CompatBadgeText}"
                                                           Text="{Binding CompatBadge}" />
                                            </Border>

                                            <CheckBox Grid.Column="3" Style="{StaticResource ToggleCheckStyle}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,2,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 右栏：启动 + 详情 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettingsCard}" Margin="0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.launch.enabled}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding SelectedCountText}" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,2,0,12" />

                                <Button x:Name="LaunchButton" Style="{StaticResource LaunchButtonStyle}"
                                        Click="Launch_Click" IsEnabled="{Binding CanLaunch}" Height="60">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource L.btn.launch}" FontSize="16" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LaunchSubtitle}" FontSize="11" Foreground="#FFE9D2"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>

                                <Button Content="{DynamicResource L.btn.resume}" Click="ResumeLatest_Click"
                                        Margin="0,10,0,0" />

                                <CheckBox Content="{DynamicResource L.chk.debug}" Style="{StaticResource OptionCheckStyle}"
                                          Margin="2,14,0,0" IsChecked="{Binding DebugMode, Mode=TwoWay}" />
                                <CheckBox Content="{DynamicResource L.chk.close}" Style="{StaticResource OptionCheckStyle}"
                                          Margin="2,9,0,0" IsChecked="{Binding CloseAfterLaunch, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Margin="0" Padding="16">
                            <Grid>
                                <StackPanel VerticalAlignment="Center"
                                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="{DynamicResource L.details.placeholder}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource L.details.placeholder2}" FontSize="11"
                                               Foreground="#C3CBD6" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel DataContext="{Binding SelectedMod}">

                                        <Grid Width="100" Height="100" HorizontalAlignment="Left">
                                            <Border CornerRadius="12" Background="#EEF2F7"
                                                    BorderBrush="#E3E9F1" BorderThickness="1" />
                                            <TextBlock Text="MOD" FontSize="14" Foreground="#A9B4C2"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Rectangle RadiusX="12" RadiusY="12">
                                                <Rectangle.Fill>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>

                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                                   Margin="0,14,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Style="{StaticResource CompatBadgeBorder}">
                                                <TextBlock Style="{StaticResource CompatBadgeText}"
                                                           Text="{Binding CompatBadge}" />
                                            </Border>
                                            <TextBlock Text="{Binding SupportedVersion}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding CompatDetail}"
                                                   Style="{StaticResource CompatDetailText}" Margin="0,10,0,0" />

                                        <TextBlock Text="{DynamicResource L.detail.tags}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource DetailValue}" />

                                        <TextBlock Text="{DynamicResource L.detail.workshop}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding RemoteLink}" Style="{StaticResource DetailValue}" />
                                        <Button Content="{DynamicResource L.btn.opensteamworkshop}" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" Click="OpenSelectedWorkshop_Click"
                                                Visibility="{Binding HasRemoteId, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Text="{DynamicResource L.detail.path}" Style="{StaticResource DetailLabel}" />
                                        <TextBlock Text="{Binding PathText}" Style="{StaticResource DetailValue}" FontSize="11" />

                                        <Button Content="{DynamicResource L.btn.openfolder}" HorizontalAlignment="Left"
                                                Margin="0,16,0,4" Click="OpenSelectedModDir_Click" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 存档页 -->
                <Grid x:Name="PageSaves" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.saves.title}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Border Background="#EAF0F7" CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SaveCountText}" FontSize="11"
                                       Foreground="{StaticResource NeutralFgBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                        <Button Content="{DynamicResource L.saves.refresh}" Click="RefreshSaves_Click" />
                        <TextBlock Text="{DynamicResource L.saves.hint}" Style="{StaticResource CardHint}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="780" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <TextBlock x:Name="SavesEmpty" Text="{DynamicResource L.saves.empty}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed" />

                        <ListBox x:Name="SaveList" SelectionChanged="SaveList_SelectionChanged" Padding="0,0,6,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SaveEntry}">
                                    <Border Style="{StaticResource ModCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="50" Height="50" CornerRadius="9" Background="#F3F6FA"
                                                    BorderBrush="#E3E9F1" BorderThickness="1">
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20" Foreground="#9AA8B8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SubLine}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource SettingsCard}" Margin="0,10,0,0" Padding="16">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="LoadSaveButton" Content="{DynamicResource L.btn.loadsave}"
                                    Style="{StaticResource AccentButtonStyle}" Click="LoadSelectedSave_Click"
                                    IsEnabled="{Binding CanLoadSave}" />
                            <TextBlock Text="{Binding SelectedSaveText}" Style="{StaticResource CardHint}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 设置页 -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.settings.language.title}"
                                               Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{DynamicResource L.settings.language.desc}"
                                               Style="{StaticResource CardHint}" />
                                    <ComboBox x:Name="LanguageCombo" Width="170" HorizontalAlignment="Left"
                                              Margin="0,12,0,0" FontSize="12"
                                              SelectionChanged="Language_SelectionChanged">
                                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                        <ComboBoxItem Content="English" Tag="en-US" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.settings.game.title}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{DynamicResource L.settings.game.desc}"
                                               Style="{StaticResource CardHint}" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{DynamicResource L.label.gamedir}" Style="{StaticResource LabelText}" Margin="0,6" />
                                        <TextBlock Grid.Column="1" Text="{Binding GameDirShort}"
                                                   Style="{StaticResource PathText}" Margin="0,6,12,6" />
                                        <Button Grid.Column="2" Content="{DynamicResource L.btn.choose}" Click="SetGameDir_Click"
                                                VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Text="{DynamicResource L.label.userdir}" Style="{StaticResource LabelText}" Margin="0,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserDirShort}"
                                                   Style="{StaticResource PathText}" Margin="0,6,12,6" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource L.btn.open}" Click="OpenUserDir_Click"
                                                VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2" Text="{DynamicResource L.label.moddir}" Style="{StaticResource LabelText}" Margin="0,6" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModDirShort}"
                                                   Style="{StaticResource PathText}" Margin="0,6,12,6" />
                                        <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource L.btn.open}" Click="OpenModDir_Click"
                                                VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="3" Text="{DynamicResource L.label.savedir}" Style="{StaticResource LabelText}" Margin="0,6" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SaveDirShort}"
                                                   Style="{StaticResource PathText}" Margin="0,6,12,6" />
                                        <Button Grid.Row="3" Grid.Column="2" Content="{DynamicResource L.btn.open}" Click="OpenSaveDir_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="{DynamicResource L.btn.autodetect}" Click="AutoDetect_Click" />
                                        <TextBlock Text="{DynamicResource L.hint.autodetect}"
                                                   Style="{StaticResource CardHint}" VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.settings.launch.title}" Style="{StaticResource SectionTitle}" />

                                    <CheckBox Content="{DynamicResource L.chk.debug}" Style="{StaticResource OptionCheckStyle}"
                                              Margin="0,14,0,0" IsChecked="{Binding DebugMode, Mode=TwoWay}" />
                                    <CheckBox Content="{DynamicResource L.chk.close}" Style="{StaticResource OptionCheckStyle}"
                                              Margin="0,9,0,0" IsChecked="{Binding CloseAfterLaunch, Mode=TwoWay}" />

                                    <TextBlock Text="{DynamicResource L.settings.launch.desc}"
                                               Style="{StaticResource CardHint}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.settings.steam.title}" Style="{StaticResource SectionTitle}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="{x:Type Ellipse}">
                                                    <Setter Property="Fill" Value="{StaticResource WarnFgBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource OkFgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SteamStatus}" Margin="8,0,0,0" FontSize="12"
                                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
                                        <Button Content="{DynamicResource L.btn.refresh}" Click="RefreshSteam_Click" Margin="14,0,0,0" />
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource L.hint.steam}"
                                               Style="{StaticResource CardHint}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.settings.shortcuts.title}" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{DynamicResource L.btn.opengame}" Click="OpenGameDir_Click" Margin="0,0,8,8" />
                                        <Button Content="{DynamicResource L.btn.openmods}" Click="OpenModDir_Click" Margin="0,0,8,8" />
                                        <Button Content="{DynamicResource L.btn.opensaves}" Click="OpenSaveDir_Click" Margin="0,0,8,8" />
                                        <Button Content="{DynamicResource L.btn.openlogs}" Click="OpenLogDir_Click" Margin="0,0,8,8" />
                                        <Button Content="{DynamicResource L.btn.openworkshop}" Click="OpenWorkshop_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.settings.about.title}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{DynamicResource L.about.line}"
                                               Style="{StaticResource ValueText}" Margin="0,10,0,0" />
                                    <TextBlock Style="{StaticResource CardHint}">
                                        <Run Text="{DynamicResource L.about.version}" />
                                        <Run Text="{Binding GameVersionFull, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="{DynamicResource L.btn.reset}" Click="ResetSettings_Click"
                                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 个性化页 -->
                <Grid x:Name="PagePersonalize" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.perso.color.title}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{DynamicResource L.perso.color.desc}"
                                               Style="{StaticResource CardHint}" />

                                    <ListBox x:Name="SwatchList" Margin="0,16,0,0" SelectionChanged="Swatch_SelectionChanged">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ThemeSwatch}">
                                                <StackPanel Width="120" Margin="0,0,4,8">
                                                    <Grid Width="56" Height="56" HorizontalAlignment="Left">
                                                        <Border x:Name="Ring" CornerRadius="28" BorderThickness="2"
                                                                BorderBrush="#E4E9F0" Background="White" />
                                                        <Border Background="{Binding Brush}" CornerRadius="24" Margin="4" />
                                                        <TextBlock x:Name="Tick" Text="&#xE73E;"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                   Foreground="White" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="11"
                                                               Foreground="{StaticResource DimBrush}"
                                                               Margin="0,6,0,0" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                                                 Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush" Value="#8A949F" />
                                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Button Content="{DynamicResource L.btn.customcolor}" Click="CustomColor_Click"
                                            HorizontalAlignment="Left" Margin="0,14,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource L.perso.bg.title}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{DynamicResource L.perso.bg.desc}"
                                               Style="{StaticResource CardHint}" />

                                    <Border x:Name="BgPreviewBorder" Height="140" CornerRadius="10"
                                            BorderThickness="1" BorderBrush="{StaticResource LineBrush}"
                                            Background="#EEF2F7" Margin="0,16,0,0" ClipToBounds="True" />

                                    <TextBlock Text="{Binding BackgroundPathText}" Style="{StaticResource PathText}"
                                               Margin="0,8,0,0" />

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="{DynamicResource L.btn.chooseimage}" Click="ChooseBackground_Click" Margin="0,0,8,8" />
                                        <Button Content="{DynamicResource L.btn.usebg}" Click="UseOfficialBackground_Click" Margin="0,0,8,8" />
                                        <Button Content="{DynamicResource L.btn.clearbg}" Click="ClearBackground_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid Height="34">
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource DimBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FooterText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
