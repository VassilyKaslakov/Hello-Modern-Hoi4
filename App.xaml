<Application x:Class="Hoi4Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Hoi4Launcher.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== 颜色 ===== -->
        <SolidColorBrush x:Key="BgBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E4E9F0" />
        <SolidColorBrush x:Key="LineSoftBrush" Color="#EEF2F7" />
        <SolidColorBrush x:Key="TextBrush" Color="#2C3746" />
        <SolidColorBrush x:Key="DimBrush" Color="#6E7B8C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A0ABBA" />

        <SolidColorBrush x:Key="AccentBrush" Color="#C4702F" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#D6833F" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#A85C22" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBF0E6" />

        <SolidColorBrush x:Key="OkFgBrush" Color="#2F8F4E" />
        <SolidColorBrush x:Key="OkBgBrush" Color="#EAF7EE" />
        <SolidColorBrush x:Key="OkLineBrush" Color="#C3E6CE" />

        <SolidColorBrush x:Key="WarnFgBrush" Color="#B0740F" />
        <SolidColorBrush x:Key="WarnBgBrush" Color="#FFF6E5" />
        <SolidColorBrush x:Key="WarnLineBrush" Color="#EFD8AC" />

        <SolidColorBrush x:Key="BadFgBrush" Color="#C24545" />
        <SolidColorBrush x:Key="BadBgBrush" Color="#FDEDED" />
        <SolidColorBrush x:Key="BadLineBrush" Color="#F1C5C5" />

        <SolidColorBrush x:Key="NeutralFgBrush" Color="#657486" />
        <SolidColorBrush x:Key="NeutralBgBrush" Color="#F0F3F7" />
        <SolidColorBrush x:Key="NeutralLineBrush" Color="#DDE4ED" />

        <!-- ===== 转换器 ===== -->
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- ===== 按钮 ===== -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F6F8FB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D8DFE9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LaunchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="LaunchBd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.30" Color="#C4702F" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LaunchBd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LaunchBd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,10">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F6F8FB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 输入框 ===== -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 列表 ===== -->
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 勾选框 ===== -->
        <Style x:Key="ToggleCheckStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Border x:Name="Box" CornerRadius="7" Background="White"
                                    BorderBrush="#C9D3DF" BorderThickness="1.6" />
                            <Path x:Name="Check" Data="M 6,12 L 10.5,16.5 L 18,7.5"
                                  Stroke="White" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionCheckStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="5" Background="White"
                                        BorderBrush="#C9D3DF" BorderThickness="1.6" />
                                <Path x:Name="Check" Data="M 4.5,9 L 7.8,12.3 L 13.8,5.4"
                                      Stroke="White" StrokeThickness="2.1"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 版本兼容徽章 ===== -->
        <Style x:Key="CompatBadgeBorder" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource NeutralBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NeutralLineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompatLevel}" Value="ok">
                    <Setter Property="Background" Value="{StaticResource OkBgBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OkLineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="patch">
                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarnLineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="old">
                    <Setter Property="Background" Value="{StaticResource BadBgBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BadLineBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="missing">
                    <Setter Property="Background" Value="{StaticResource BadBgBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BadLineBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompatBadgeText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource NeutralFgBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompatLevel}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource OkFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="patch">
                    <Setter Property="Foreground" Value="{StaticResource WarnFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="old">
                    <Setter Property="Foreground" Value="{StaticResource BadFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="missing">
                    <Setter Property="Foreground" Value="{StaticResource BadFgBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompatDetailText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CompatLevel}" Value="ok">
                    <Setter Property="Foreground" Value="{StaticResource OkFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="patch">
                    <Setter Property="Foreground" Value="{StaticResource WarnFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="old">
                    <Setter Property="Foreground" Value="{StaticResource BadFgBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CompatLevel}" Value="missing">
                    <Setter Property="Foreground" Value="{StaticResource BadFgBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 文字样式 ===== -->
        <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>

        <Style x:Key="DetailValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="CardHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="ValueText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <Style x:Key="PathText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>

        <Style x:Key="LabelText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ===== 卡片 ===== -->
        <Style x:Key="SettingsCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

    </Application.Resources>
</Application>
